# Developer Portal → Bot → Reset Token. Never commit the real token.
DISCORD_TOKEN=

# Discord → Settings → Advanced → Developer Mode, then right-click the server → Copy Server ID.
GUILD_ID=

# Cursor Dashboard → API Keys. /cursor stays quiet until this is set.
# CURSOR_API_KEY=
# Optional. Defaults to this GitHub repo and the main branch.
# CURSOR_REPOSITORY=https://github.com/akemixcreative-source/cursor
# CURSOR_REF=main
