# Public site URL for metadata + Open Graph (no trailing slash).
# Use a full URL with protocol (e.g. https://yoursite.com). Invalid values are ignored.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com booking link (Contact + Start a project)
NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/venera/intro?overlayCalendar=true

# Optional studio inbox printed in the footer
NEXT_PUBLIC_CONTACT_EMAIL=

# Instagram profile URL (contact form link)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yourhandle
