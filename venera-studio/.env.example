# Public site URL used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Contact form email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_INBOX_EMAIL=

# Aphrodite (site AI panel) via Cloudflare Workers AI. Shares CLOUDFLARE_ACCOUNT_ID
# below; needs its own token with Workers AI read/run permission. Without the
# token the panel simply does not render.
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=@cf/zai-org/glm-4.7-flash
# Optional: point at an AI Gateway endpoint instead of calling Workers AI directly.
CLOUDFLARE_WORKERS_AI_BASE_URL=

# Cloudflare Stream playback and upload settings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
STREAM_VIDEO_MAP={}
STREAM_REQUIRE_SIGNED=0
